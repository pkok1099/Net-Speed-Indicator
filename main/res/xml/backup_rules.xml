<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and below (full-backup-content).
    The speed settings and daily usage history (SharedPreferences) are safe and
    useful to restore. The crash log directory is EXCLUDED: crash reports
    contain device identifiers, paths and stack traces and have no business in
    the user's cloud backup.
-->
<full-backup-content>
    <exclude domain="file" path="startup_crash.log" />
    <exclude domain="external" path="startup_crash.log" />
</full-backup-content>
