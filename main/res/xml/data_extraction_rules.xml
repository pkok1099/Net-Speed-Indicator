<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (cloud backup + device transfer).
    Same policy as backup_rules.xml: keep the restoreable settings/usage
    history, exclude the on-disk crash log (device info + stack traces).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="startup_crash.log" />
        <exclude domain="external" path="startup_crash.log" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="startup_crash.log" />
        <exclude domain="external" path="startup_crash.log" />
    </device-transfer>
</data-extraction-rules>
